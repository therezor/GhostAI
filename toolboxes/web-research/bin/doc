#!/usr/bin/env python3
"""Read a document in /workspace as text.

The counterpart to `fetch`: that one turns a URL into text, this one turns a
file into text. The file is usually something a person attached to the message —
those land in `/workspace/uploads/` — and for anything that is not plain text the
model receives only the path, so this is how it reads what it was sent.

One command rather than one per format, because the model should not have to
know that a `.xlsx` needs different handling from a `.pdf` to answer "what is in
this file". Naming the format is a decision it would have to get right before it
knew anything about the contents.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

from ghostdoc import (
    DocError,
    Extracted,
    OCR_MAX_PAGES,
    read_docx,
    read_image,
    read_pdf,
    read_pptx,
    read_text,
    read_xlsx,
)

# The same cap `fetch` uses, and for the same reason: roughly 6k tokens is enough
# for almost any single document, and a file that exceeds it is one `rg` away
# rather than one context window away.
DEFAULT_MAX_CHARS = 24_000

IMAGES = {".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".tif", ".tiff"}


def extract(path: Path, args: argparse.Namespace) -> Extracted:
    """Whichever reader this file needs. Extension first, bytes as the tiebreak."""
    suffix = path.suffix.lower()

    if suffix == ".pdf":
        return read_pdf(path, args.lang, not args.no_ocr, args.ocr_pages)
    if suffix in IMAGES:
        return read_image(path, args.lang, not args.no_ocr)
    if suffix == ".docx":
        return read_docx(path)
    if suffix in {".xlsx", ".xlsm"}:
        return read_xlsx(path, args.max_rows)
    if suffix == ".pptx":
        return read_pptx(path)

    # Not a format with a dedicated reader. The bytes decide: a `.py`, a `.csv`
    # and a file with no extension at all are text and readable; anything with a
    # NUL in its first pages is not, and says so rather than printing mojibake.
    text = read_text(path)
    if text is not None:
        return text
    return Extracted(
        text="",
        kind="binary",
        note=(
            f"{path.name} is not text and has no reader here. Formats this "
            "toolbox reads: pdf, docx, xlsx, pptx, images, and anything text."
        ),
    )


def emit(path: Path, result: Extracted, args: argparse.Namespace, many: bool) -> int:
    if many:
        print(f"\n===== {path} =====")

    header = f"# {path.name}"
    if result.note:
        header += f"\n{result.note}"
    print(header)
    print()

    if not result.text:
        # An empty result is not silent. A model holding one cannot tell "the
        # file is blank" from "the wrong tool ran", and the note above is the
        # difference — so this only reports the exit code.
        return 0 if result.kind in {"text", "docx", "xlsx", "pptx"} else 2

    body = result.text
    if args.max_chars and len(body) > args.max_chars:
        dropped = len(body) - args.max_chars
        body = body[: args.max_chars]
        body += (
            f"\n\n[cut here: {dropped:,} more characters. "
            f"Use --max-chars 0 for all of it, or rg the file directly.]"
        )
    print(body)

    if args.save:
        target = Path(args.save)
        if target.is_dir():
            target = target / f"{path.stem}.txt"
        target.write_text(result.text, "utf-8")
        print(f"\n[written to {target}]")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="doc",
        description="Read a document in /workspace as text.",
    )
    parser.add_argument("paths", nargs="+", help="One or more files.")
    parser.add_argument(
        "--max-chars",
        type=int,
        default=DEFAULT_MAX_CHARS,
        help="Cap on printed characters per file. 0 removes it.",
    )
    parser.add_argument(
        "--lang",
        default="eng",
        help=(
            "OCR language(s), as tesseract codes joined by '+': deu, fra, spa, "
            "ita, por, nld, rus, ukr, swe, nor, dan, fin. Default eng."
        ),
    )
    parser.add_argument(
        "--no-ocr", action="store_true", help="Never run OCR, however empty the result."
    )
    parser.add_argument(
        "--ocr-pages",
        type=int,
        default=OCR_MAX_PAGES,
        help=f"Most PDF pages to OCR (default {OCR_MAX_PAGES}).",
    )
    parser.add_argument(
        "--max-rows", type=int, default=2000, help="Most spreadsheet rows per sheet."
    )
    parser.add_argument("--save", help="Also write the extracted text to this file or directory.")
    args = parser.parse_args()

    status = 0
    many = len(args.paths) > 1
    for name in args.paths:
        path = Path(name)
        if not path.exists():
            print(f"doc: {path}: no such file", file=sys.stderr)
            status = 1
            continue
        if path.is_dir():
            print(f"doc: {path} is a directory — name a file, or use ls", file=sys.stderr)
            status = 1
            continue
        try:
            result = extract(path, args)
        except DocError as error:
            print(f"doc: {path}: {error}", file=sys.stderr)
            status = 1
            continue
        status = max(status, emit(path, result, args, many))

    return status


if __name__ == "__main__":
    raise SystemExit(main())
