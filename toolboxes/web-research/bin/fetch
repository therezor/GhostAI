#!/usr/bin/env python3
"""Read one or more web pages as markdown.

The single most-used tool in the box, so its defaults are the ones that make the
common call correct with no flags: main content only, markdown, a cap on how much
comes back inline, and the full copy on disk when the cap bites.

Why not `curl`: a documentation page is typically 80–95% markup and navigation.
Handing that to a model costs ten times the tokens and reads worse. `curl` is
still here for an API that returns JSON, which is the case where raw bytes are
the point.
"""

from __future__ import annotations

import argparse
import sys
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

from ghostweb import FetchError, fetch_page, http_get, links_in, truncate

# Roughly 6k tokens: enough for almost any single article, small enough that
# fetching three pages in one call cannot blow a context window. The full text is
# always written to disk when this bites, so the cap costs nothing but a second
# command.
DEFAULT_MAX_CHARS = 24_000

# Fetches run concurrently because they are all waiting on the network, and four
# is polite to the origin as well as fast.
WORKERS = 4


def emit(page_index: int, total: int, page, limit: int, save_dir: Path | None) -> int:
    """One page's output. Returns the process exit code contribution."""
    if total > 1:
        # A separator, so a model reading three pages in one result can tell where
        # one ends. Cheap, and without it the answer is a wall.
        print(f"\n===== [{page_index}/{total}] {page.url} =====")

    if page.title:
        print(f"# {page.title}")
        print(f"<{page.url}>")
        print()

    if not page.ok:
        print(f"fetch: {page.note}", file=sys.stderr)
        return 2

    if page.note:
        print(f"> note: {page.note}\n")

    saved: Path | None = None
    if save_dir is not None:
        saved = write_copy(save_dir, page)

    body, dropped = truncate(page.text, limit)
    print(body)

    if dropped:
        where = (
            f"the full {len(page.text):,} characters are in {saved}"
            if saved is not None
            else "re-run with --save /workspace to keep the whole thing, "
            "or --max-chars 0 to print it"
        )
        print(f"\n[{dropped:,} characters not shown — {where}]")
    elif saved is not None:
        print(f"\n[saved to {saved}]")

    return 0


def write_copy(directory: Path, page) -> Path | None:
    """The extracted text, in the workspace, under a name derived from the URL.

    Derived rather than asked for: naming a file per fetch is a decision the model
    should not have to make, and a name it invents is one it then has to remember.
    """
    from urllib.parse import urlparse

    parsed = urlparse(page.url)
    stem = "-".join(part for part in (parsed.netloc + parsed.path).split("/") if part)
    stem = "".join(char if char.isalnum() or char in "-._" else "-" for char in stem)[:80]
    target = directory / f"{stem or 'page'}.md"

    try:
        directory.mkdir(parents=True, exist_ok=True)
        header = f"# {page.title}\n<{page.url}>\n\n" if page.title else f"<{page.url}>\n\n"
        target.write_text(header + page.text + "\n", encoding="utf-8")
    except OSError as error:
        print(f"fetch: could not save to {target}: {error}", file=sys.stderr)
        return None
    return target


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="fetch",
        description="Read web pages as markdown: main content, no navigation, no markup.",
    )
    parser.add_argument("urls", nargs="+", metavar="URL")
    parser.add_argument(
        "--max-chars",
        type=int,
        default=DEFAULT_MAX_CHARS,
        metavar="N",
        help=f"cap the text printed per page (default {DEFAULT_MAX_CHARS}; 0 for no cap)",
    )
    parser.add_argument(
        "--save",
        metavar="DIR",
        help="also write each page to DIR as markdown, and print where",
    )
    parser.add_argument(
        "--links",
        action="store_true",
        help="print the page's links instead of its text, as URL<TAB>text",
    )
    parser.add_argument(
        "--no-cache", action="store_true", help="re-request even if this URL was already fetched"
    )
    args = parser.parse_args()

    if args.links:
        status = 0
        for url in args.urls:
            try:
                body, final_url, _ = http_get(url)
            except FetchError as error:
                print(f"fetch: {error}", file=sys.stderr)
                status = 1
                continue
            for href, text in links_in(body, final_url):
                print(f"{href}\t{text}")
        return status

    save_dir = Path(args.save) if args.save else None

    def one(url: str):
        try:
            return fetch_page(url, use_cache=not args.no_cache)
        except FetchError as error:
            return error

    with ThreadPoolExecutor(max_workers=min(WORKERS, len(args.urls))) as pool:
        results = list(pool.map(one, args.urls))

    status = 0
    for index, result in enumerate(results, start=1):
        if isinstance(result, FetchError):
            print(f"fetch: {result}", file=sys.stderr)
            status = 1
            continue
        status = max(status, emit(index, len(results), result, args.max_chars, save_dir))

    return status


if __name__ == "__main__":
    raise SystemExit(main())
