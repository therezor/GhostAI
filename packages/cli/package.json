{
  "name": "@ghostai/cli",
  "version": "0.0.0",
  "description": "GhostAI command line interface.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "bin": {
    "ghost": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@ghostai/agent": "workspace:*",
    "@ghostai/core": "workspace:*",
    "@ghostai/protocol": "workspace:*",
    "@ghostai/providers": "workspace:*",
    "@ghostai/security": "workspace:*",
    "@ghostai/tools": "workspace:*",
    "commander": "^13.0.0",
    "picocolors": "^1.1.0"
  }
}
