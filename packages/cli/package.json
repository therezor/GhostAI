{
  "name": "@ghostai/cli",
  "version": "0.0.0",
  "description": "GhostAI command line interface.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "ghost": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup && tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@ghostai/agent": "workspace:*",
    "@ghostai/channels": "workspace:*",
    "@ghostai/core": "workspace:*",
    "@ghostai/i18n": "workspace:*",
    "@ghostai/protocol": "workspace:*",
    "@ghostai/providers": "workspace:*",
    "@ghostai/runtime": "workspace:*",
    "@ghostai/security": "workspace:*",
    "@ghostai/server": "workspace:*",
    "@ghostai/tools": "workspace:*",
    "@ghostai/tui": "workspace:*",
    "@ghostai/web": "workspace:*",
    "commander": "^13.0.0",
    "i18next": "^26.3.6",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "ws": "^8.18.0"
  }
}
