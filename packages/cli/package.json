{
  "name": "@ghostbot/cli",
  "version": "0.7.1",
  "description": "GhostAI command line interface.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therezor/GhostAI.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/therezor/GhostAI",
  "bugs": "https://github.com/therezor/GhostAI/issues",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo"
  ],
  "bin": {
    "ghost": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup && tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@ghostbot/agent": "workspace:*",
    "@ghostbot/channels": "workspace:*",
    "@ghostbot/core": "workspace:*",
    "@ghostbot/extension-host": "workspace:*",
    "@ghostbot/i18n": "workspace:*",
    "@ghostbot/protocol": "workspace:*",
    "@ghostbot/providers": "workspace:*",
    "@ghostbot/runtime": "workspace:*",
    "@ghostbot/security": "workspace:*",
    "@ghostbot/server": "workspace:*",
    "@ghostbot/tools": "workspace:*",
    "@ghostbot/tui": "workspace:*",
    "@ghostbot/web": "workspace:*",
    "commander": "^13.0.0",
    "i18next": "^26.3.6",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "ws": "^8.18.0"
  }
}
