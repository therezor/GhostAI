{
  "name": "@ghostai/tui",
  "version": "0.0.0",
  "description": "A domain-free terminal toolkit: key decoding, display-width text, and a transient selection region.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*",
    "#testkit/*": "./test/testkit/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "picocolors": "^1.1.0"
  }
}
