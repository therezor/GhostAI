{
  "name": "@ghostbot/agent",
  "version": "1.0.0",
  "description": "The agent loop, subagent manager, and context contributors.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therezor/GhostAI.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/therezor/GhostAI",
  "bugs": "https://github.com/therezor/GhostAI/issues",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testkit": {
        "types": "./test/testkit/index.ts",
        "default": "./test/testkit/index.ts"
      }
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testkit": {
      "types": "./test/testkit/index.ts",
      "default": "./test/testkit/index.ts"
    }
  },
  "imports": {
    "#src/*": "./src/*",
    "#testkit/*": "./test/testkit/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo",
    "test/testkit"
  ],
  "scripts": {
    "build": "tsup && tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@ghostbot/core": "workspace:*",
    "@ghostbot/protocol": "workspace:*",
    "@ghostbot/providers": "workspace:*",
    "@ghostbot/security": "workspace:*",
    "@ghostbot/tools": "workspace:*"
  },
  "devDependencies": {
    "zod": "^4.0.0"
  }
}
