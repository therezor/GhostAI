{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],

    // Vite owns the JavaScript here, so `tsc -b` is a checker rather than a
    // compiler — unlike every other package, where tsup emits the JS and tsc
    // emits the declarations. Nothing imports `@ghostai/web` for its types:
    // `ghost serve` resolves its `package.json` to find `dist/`, at runtime.
    "noEmit": true,
    "emitDeclarationOnly": false,
    "tsBuildInfoFile": "./.tsbuildinfo",

    // A React component's props are inferred from JSX, which is exactly the
    // shape `isolatedDeclarations` cannot write a declaration for — and with
    // nothing to declare, there is nothing for it to protect.
    "isolatedDeclarations": false,

    "rootDir": "./src",

    // `@/` for anything outside the current directory. The repo bans
    // `../../*` imports because that is how one package reaches into another's
    // source — and inside a package with a `components/ui/` depth, the same
    // pattern is just a relative path. The alias sidesteps the ambiguity
    // instead of loosening the rule that catches the real thing.
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
