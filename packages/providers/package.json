{
  "name": "@ghostwire/providers",
  "version": "0.7.3",
  "description": "LLM provider registry, wire adapters, and resilience decorator.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therezor/GhostAI.git",
    "directory": "packages/providers"
  },
  "homepage": "https://github.com/therezor/GhostAI",
  "bugs": "https://github.com/therezor/GhostAI/issues",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*",
    "#testkit/*": "./test/testkit/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsup && tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@ghostwire/core": "workspace:*",
    "@ghostwire/protocol": "workspace:*",
    "@ghostwire/security": "workspace:*",
    "gpt-tokenizer": "^2.8.0",
    "undici": "^7.2.0"
  }
}
