{
  "name": "@ghostai/server",
  "version": "1.0.0",
  "description": "Fastify app, boot policy, authentication, and the session hub.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therezor/GhostAI.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/therezor/GhostAI",
  "bugs": "https://github.com/therezor/GhostAI/issues",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*",
    "#testkit/*": "./test/testkit/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsup && tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/static": "^8.1.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/websocket": "^11.0.0",
    "@ghostai/agent": "workspace:*",
    "@ghostai/core": "workspace:*",
    "@ghostai/protocol": "workspace:*",
    "@ghostai/providers": "workspace:*",
    "@ghostai/security": "workspace:*",
    "@ghostai/tools": "workspace:*",
    "@node-rs/argon2": "^2.0.0",
    "fastify": "^5.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@readme/openapi-parser": "^6.3.0",
    "@types/ws": "^8.5.0",
    "ws": "^8.18.0"
  }
}
