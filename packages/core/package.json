{
  "name": "@ghostbot/core",
  "version": "0.7.1",
  "description": "Canonical message types, session store, message bus, logger, clock.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therezor/GhostAI.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/therezor/GhostAI",
  "bugs": "https://github.com/therezor/GhostAI/issues",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsup && tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@ghostbot/i18n": "workspace:*",
    "@ghostbot/protocol": "workspace:*",
    "pino": "^9.5.0",
    "zod": "^4.0.0"
  }
}
