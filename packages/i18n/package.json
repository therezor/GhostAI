{
  "name": "@ghostai/i18n",
  "version": "0.0.0",
  "description": "The translation layer: i18next instance, locale negotiation and locale-aware formatting primitives.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "development": "./src/web.ts",
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./cli": {
      "development": "./src/cli.ts",
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./locales/*": "./locales/*",
    "./package.json": "./package.json"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "locales"
  ],
  "scripts": {
    "build": "tsup && tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "i18next": "^26.3.6"
  }
}
